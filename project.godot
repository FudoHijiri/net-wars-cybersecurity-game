; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NetWars Cybersecurity Game"
run/main_scene="uid://bb7tdulcsutsp"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SceneManager="*uid://bgcgjakii6a4w"
GameState="*res://autoload/game_state.gd"
SaveManager="*res://autoload/save_manager.gd"
Settings="*uid://c1xey3c6qhddm"
ColorblindFilter="*res://autoload/colorblind_filter.gd"
InterfaceColors="*res://AI generated/scripts/accessibility/interface_colors.gd"
ScreenEffects="*res://AI generated/scripts/accessibility/screen_effects.gd"
Fx="*res://scripts/fx/fx_overlay.gd"
DebugPanel="*res://AI generated/scenes/debug/DebugPanel.tscn"
PauseMenu="*res://scenes/gameplay/PauseMenu.tscn"
GameCursor="*res://autoload/game_cursor.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/borderless=true
window/size/extend_to_title=true
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="NetWars Cybersecurity Game"

[gui]

theme/default_font_subpixel_positioning=0
theme/custom="res://assets/ui/tooltip_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
