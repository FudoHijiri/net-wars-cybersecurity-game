[node name="RecoveryTask" type="Control"]
editor_description = "Shared repair screen, drawn as the monitor of the machine the player opened. Bezel = the plastic, Frame = the screen, TitleBar = machine name + system (content.machine, content.system), Stamp = the REPAIRED pop-up. Task scenes add their controls under Frame/Layout/Body."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_task")
group_icons = {
"access": ExtResource("3_access"),
"backup": ExtResource("6_backup"),
"default": ExtResource("7_default"),
"monitoring": ExtResource("4_monitoring"),
"network": ExtResource("5_servers"),
"servers": ExtResource("5_servers")
}

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.101960786, 0.10980392, 0.17254902, 0.9)

[node name="Bezel" type="PanelContainer" parent="."]
