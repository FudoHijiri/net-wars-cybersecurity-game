[gd_scene load_steps=4 format=3]

[ext_resource type="PackedScene" path="res://scenes/gameplay/recovery/tasks/RecoveryTask.tscn" id="1_base"]
[ext_resource type="Script" path="res://scripts/gameplay/recovery/back_to_work.gd" id="2_task"]
[ext_resource type="PackedScene" path="res://scenes/gameplay/recovery/tasks/parts/ChoiceCard.tscn" id="3_card"]

[node name="BackToWork" instance=ExtResource("1_base")]
editor_description = "Back to Work (file server): the Day 1 Final Check. Sign Anna in with her new password, type her phone code, open her file. Content from components.file_server (its scene entry points here)."
script = ExtResource("2_task")
component_id = "file_server"

[node name="Main" type="HBoxContainer" parent="Frame/Layout/Body" index="0"]
layout_mode = 2
size_flags_vertical = 3

[node name="StepsPanel" type="PanelContainer" parent="Frame/Layout/Body/Main"]
custom_minimum_size = Vector2(118, 0)
layout_mode = 2
theme_type_variation = &"RecoveryWindow"

[node name="Steps" type="VBoxContainer" parent="Frame/Layout/Body/Main/StepsPanel"]
layout_mode = 2
theme_override_constants/separation = 10

