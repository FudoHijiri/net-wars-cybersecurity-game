[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/gameplay/recovery/ui/recovery_choice_card.gd" id="1_card"]

[node name="ChoiceCard" type="Button"]
editor_description = "One option card (heading + detail). Used for the password choices; restyle the RecoveryCard / RecoveryCardGood theme variations to change every card."
custom_minimum_size = Vector2(0, 64)
size_flags_horizontal = 3
theme_type_variation = &"RecoveryCard"
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 8

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6
alignment = 1

[node name="Heading" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RecoveryHeading"
text = "Option"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Detail" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
