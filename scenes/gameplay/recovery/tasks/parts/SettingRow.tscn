[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/gameplay/recovery/ui/recovery_session_row.gd" id="1_row"]

[node name="SettingRow" type="PanelContainer"]
editor_description = "One activity-log entry: time, who, what happened, and an Undo button. Uses the SessionRow script (Device = time, Place = who, Time = what happened)."
size_flags_horizontal = 3
theme_type_variation = &"RecoveryHeader"
script = ExtResource("1_row")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Device" type="Label" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(60, 0)
layout_mode = 2
mouse_filter = 2
text = "Setting"

[node name="Place" type="Label" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RecoveryMuted"
text = "Who"

[node name="Time" type="Label" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"RecoveryWarning"
text = "What happened"

[node name="Status" type="Label" parent="Row"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(96, 22)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RecoverySuccess"
text = "[OK] UNDONE"
horizontal_alignment = 2
vertical_alignment = 1

[node name="SignOut" type="Button" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 22)
layout_mode = 2
text = "Undo"
