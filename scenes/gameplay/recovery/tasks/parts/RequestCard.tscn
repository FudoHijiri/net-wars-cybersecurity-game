[node name="Details" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
text = "Name: -
Staff no.: -
Phone: -
Sent from: -"

[node name="Status" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
