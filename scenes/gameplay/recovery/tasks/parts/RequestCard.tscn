[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/gameplay/recovery/ui/recovery_request_card.gd" id="1_card"]

[node name="RequestCard" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"RecoveryHeader"
