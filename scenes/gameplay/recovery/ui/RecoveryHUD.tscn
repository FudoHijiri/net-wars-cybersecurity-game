[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/gameplay/recovery/ui/recovery_hud.gd" id="1_hud"]
[ext_resource type="Theme" path="res://assets/recovery/ui/recovery_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://assets/ui/Recovery Icon.png" id="3_icon"]
[ext_resource type="Texture2D" path="res://assets/ui/Pause Icon.png" id="4_pause"]
[ext_resource type="FontFile" path="res://assets/font/Minecraft Standard 6px/MinecraftStandardBold.otf" id="5_bold"]

[node name="RecoveryHUD" type="CanvasLayer"]
layer = 10
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")

[node name="Header" type="PanelContainer" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 24.0
grow_horizontal = 2
theme_type_variation = &"RecoveryHUDBar"

[node name="Row" type="HBoxContainer" parent="Root/Header"]
layout_mode = 2

[node name="Icon" type="TextureRect" parent="Root/Header/Row"]
layout_mode = 2
mouse_filter = 2
texture = ExtResource("3_icon")
stretch_mode = 3

[node name="Objective" type="Label" parent="Root/Header/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.8039216, 0.45882353, 1)
theme_override_fonts/font = ExtResource("5_bold")
theme_override_font_sizes/font_size = 6
text = "OBJECTIVE"

[node name="PracticeBadge" type="Label" parent="Root/Header/Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RecoveryMuted"
text = "PRACTICE"

[node name="Counter" type="Label" parent="Root/Header/Row"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RecoveryWarning"
text = "0/2 checks"

[node name="PauseButton" type="TextureButton" parent="Root/Header/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(16, 16)
layout_mode = 2
size_flags_vertical = 4
texture_normal = ExtResource("4_pause")
ignore_texture_size = true
stretch_mode = 0

[node name="InteractionHint" type="Label" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -20.0
offset_right = -16.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_type_variation = &"RecoveryHint"
text = "WASD / arrows: move     E: use     Esc: pause"
horizontal_alignment = 1

[connection signal="pressed" from="Root/Header/Row/PauseButton" to="." method="_on_pause_pressed"]
